---
/**
 * 今日戰鬥升級: each mission's targeted reward for the day, with the in-game emblem so readers who don't
 * know brand names can still recognise them. Data: data/daily-loot.json (the robot reads 巴哈's pinned daily
 * thread every update). Icons: public/icons/ (white glyphs made from Ubisoft art on The Division Wiki), shown
 * on a dark tile and tinted like the game: brands and gear slots white, gear sets green. A name we can't match
 * with confidence (e.g. 特種合金) shows as text, never a guessed logo.
 */
import loot from '../../data/daily-loot.json' with { type: 'json' };
import brands from '../../data/brands.json' with { type: 'json' };
import { t, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
  /** The edition's date; the box shows only when the loot is for that day or the day before. */
  date: string;
}
const { locale, date } = Astro.props;
const en = locale === 'en';
const fresh = Date.parse(date) - Date.parse(loot.date) <= 86_400_000 && Date.parse(loot.date) <= Date.parse(date);

const norm = (s: string) => s.replace(/\s+/g, '').replace(/＆/g, '&');
type Entry = { en: string; aliases: string[]; icon: string | null };
const find = (list: Entry[], name: string) => list.find((b) => b.aliases.some((a) => norm(a) === norm(name)));
const LISTS = { brand: brands.brands, set: brands.sets, slot: brands.slots } as Record<string, Entry[]>;
/** The poster's cell colour says which list to look in; an unmarked cell may be any of them. */
const match = (name: string, kind: string) => {
  for (const k of LISTS[kind] ? [kind] : ['brand', 'set', 'slot']) {
    const hit = find(LISTS[k]!, name);
    if (hit) return { ...hit, tint: k === 'set' ? 'set' : 'white' };
  }
  return undefined;
};
const rows = loot.missions.map((m) => ({ ...m, hit: match(m.reward, m.kind) }));
const vendor = loot.vendor.map((v) => ({ name: v, hit: match(v, 'other') }));
const kindLabel = (k: string) => t(locale, `loot.kind.${k === 'brand' || k === 'set' || k === 'slot' ? k : 'other'}` as never);
const md = loot.date.slice(5).replace('-', '/');
---
{
  fresh && (
    <section class="loot" aria-labelledby="loot-h">
      <h2 id="loot-h" class="hud-label">
        {t(locale, 'loot.title')} <span class="d">{md}</span>
      </h2>
      <ul>
        {rows.map((r) => (
          <li class={`k-${r.kind}`}>
            <span class="place">{r.place}</span>
            <span class="reward">
              {r.hit?.icon ? (
                <span class={`tile t-${r.hit.tint}`} aria-hidden="true">
                  <span class="glyph" style={`--icon:url(${r.hit.icon})`} />
                </span>
              ) : (
                <span class={`tile none k-${r.kind}`} aria-hidden="true">{r.reward.slice(0, 1)}</span>
              )}
              <span class="names">
                <strong>{en && r.hit ? r.hit.en : r.reward}</strong>
                <small>
                  {kindLabel(r.kind)}
                  {!en && r.hit && <> · {r.hit.en}</>}
                </small>
              </span>
            </span>
          </li>
        ))}
      </ul>
      {vendor.length > 0 && (
        <p class="vendor">
          <strong>{t(locale, 'loot.vendor')}</strong>
          {vendor.map((v) => (
            <span class="vitem">
              {v.hit?.icon && (
                <span class={`tile sm t-${v.hit.tint}`} aria-hidden="true">
                  <span class="glyph" style={`--icon:url(${v.hit.icon})`} />
                </span>
              )}
              {en && v.hit ? v.hit.en : v.name}
            </span>
          ))}
        </p>
      )}
      <p class="credit">
        {t(locale, 'loot.credit')} <a href={loot.url} rel="noopener noreferrer" target="_blank">{t(locale, 'loot.source')}</a>
      </p>
    </section>
  )
}

<style>
  .loot {
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-3) var(--space-2);
    border: 2px solid var(--ink);
    border-left: 6px solid var(--shd);
    background: var(--paper);
  }
  .loot h2 {
    margin: 0 0 var(--space-2);
    color: var(--shd-ink);
    font: 800 var(--step-0) / 1.2 var(--font-hud);
  }
  .loot h2 .d {
    color: var(--ink-soft);
    font-weight: 600;
  }
  .loot ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .loot li {
    display: grid;
    grid-template-columns: minmax(5.5em, 7em) 1fr;
    align-items: center;
    gap: var(--space-2);
    padding: 6px 0;
    border-top: 1px dashed var(--rule-soft);
  }
  .loot li:first-child {
    border-top: 0;
  }
  .place {
    font-weight: 700;
  }
  .reward {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }
  /* The game's look: a dark square with the emblem in white (gear sets in green). */
  .tile {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid #5b6270;
    background: #262a33;
  }
  .tile.sm {
    width: 26px;
    height: 26px;
  }
  .glyph {
    width: 82%;
    height: 82%;
    background: #f2f2f2;
    -webkit-mask: var(--icon) center / contain no-repeat;
    mask: var(--icon) center / contain no-repeat;
  }
  .t-set .glyph {
    background: #2ee59d;
  }
  .tile.none {
    color: #f2f2f2;
    font: 700 1rem / 1 var(--font-hud);
  }
  .tile.none.k-set {
    color: #2ee59d;
  }
  .names {
    display: grid;
    min-width: 0;
  }
  .names strong {
    overflow-wrap: anywhere;
  }
  .names small {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  .vendor {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
    margin: var(--space-2) 0 0;
  }
  .vitem {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .credit {
    margin: var(--space-1) 0 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
</style>
