---
/**
 * 收藏: the script behind every ☆ button ([data-fav="<story id>"]).
 * Favorites live only in this browser (localStorage "dcd.favs"): nothing is sent to the server,
 * so nobody else can see or change them. Each phone or computer keeps its own list.
 */
import { t, type Locale } from '../i18n/index.ts';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---
<div
  hidden
  data-fav-labels
  data-fav-add={t(locale, 'fav.add')}
  data-fav-remove={t(locale, 'fav.remove')}
  data-fav-added={t(locale, 'fav.added')}
  data-fav-removed={t(locale, 'fav.removed')}
>
</div>
<p class="fav-toast" data-fav-toast role="status" hidden></p>

<style>
  .fav-toast {
    position: fixed;
    left: 50%;
    bottom: calc(84px + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    z-index: 60;
    max-width: calc(100vw - 32px);
    padding: 10px 16px;
    border-radius: 20px;
    background: var(--panel);
    color: var(--panel-ink);
    font: 600 0.9375rem / 1.3 var(--font-hud);
    box-shadow: 0 3px 10px rgb(0 0 0 / 0.25);
  }
  .fav-toast[hidden] {
    display: none;
  }
</style>
<script>
  type Fav = { id: string; at: string };
  const CACHE = 'dcd.favs';
  const MAX = 500;
  const labels = document.querySelector<HTMLElement>('[data-fav-labels]')?.dataset ?? {};
  const L = (k: string) => labels[k] ?? '';
  const store = {
    get(k: string) {
      try {
        return localStorage.getItem(k);
      } catch {
        return null;
      }
    },
    set(k: string, v: string) {
      try {
        localStorage.setItem(k, v);
      } catch {}
    },
  };
  // Older versions saved { who, favs } (one list per household name); the list carries over as this device's.
  let favs: Fav[] = (() => {
    try {
      const c = JSON.parse(store.get(CACHE) ?? 'null');
      const list = Array.isArray(c) ? c : c?.favs;
      return Array.isArray(list) ? list.filter((f) => f && typeof f.id === 'string' && typeof f.at === 'string') : [];
    } catch {
      return [];
    }
  })();
  const toastBox = document.querySelector<HTMLElement>('[data-fav-toast]');
  let toastTimer = 0;
  function toast(msg: string) {
    if (!toastBox) return;
    toastBox.textContent = msg;
    toastBox.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (toastBox.hidden = true), 2200);
  }
  function save() {
    store.set(CACHE, JSON.stringify({ favs }));
    paint();
    document.dispatchEvent(new CustomEvent('dcd:favs', { detail: { favs } }));
  }
  function paint() {
    const on = new Set(favs.map((f) => f.id));
    document.querySelectorAll<HTMLButtonElement>('[data-fav]').forEach((b) => {
      const yes = on.has(b.dataset.fav!);
      b.setAttribute('aria-pressed', String(yes));
      b.setAttribute('aria-label', yes ? L('favRemove') : L('favAdd'));
      const icon = b.querySelector('.fav-icon');
      if (icon) icon.textContent = yes ? '★' : '☆';
    });
  }
  function toggle(id: string) {
    const on = !favs.some((f) => f.id === id);
    favs = on ? [{ id, at: new Date().toISOString() }, ...favs].slice(0, MAX) : favs.filter((f) => f.id !== id);
    save();
    toast(on ? L('favAdded') : L('favRemoved'));
  }
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>('[data-fav]');
    if (b) {
      e.preventDefault();
      toggle(b.dataset.fav!);
    }
  });
  // Another tab changed the list: follow it.
  addEventListener('storage', (e) => {
    if (e.key !== CACHE) return;
    try {
      favs = JSON.parse(e.newValue ?? '{}').favs ?? [];
    } catch {}
    paint();
    document.dispatchEvent(new CustomEvent('dcd:favs', { detail: { favs } }));
  });

  // Other pages (e.g. 我的收藏) can ask for the current list.
  (window as unknown as { dcdFavs: () => { favs: Fav[] } }).dcdFavs = () => ({ favs });
  paint();
  document.dispatchEvent(new CustomEvent('dcd:favs', { detail: { favs } }));
</script>
