---
/**
 * Live Now: fetches /api/live after the page loads and shows click-to-play Twitch cards.
 * Nothing from Twitch's player loads until the reader taps a card. All text from Twitch is
 * inserted with textContent (never innerHTML).
 */
import { t, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
  compact?: boolean;
}
const { locale, compact = false } = Astro.props;
const strings = {
  loading: t(locale, 'live.loading'),
  offline: t(locale, 'live.offline'),
  unavailable: t(locale, 'live.unavailable'),
  viewers: t(locale, 'live.viewers'),
  badge: t(locale, 'live.badge'),
  clips: t(locale, 'live.clips'),
  onTwitch: t(locale, 'live.onTwitch'),
  play: t(locale, 'live.play'),
  locale: locale === 'en' ? 'en' : 'zh-Hant-TW',
};
const CATEGORY = 'https://www.twitch.tv/directory/category/tom-clancys-the-division-2';
---
<div class:list={['live', compact && 'compact']} data-live data-strings={JSON.stringify(strings)} data-max={compact ? 3 : 12}>
  <p class="state hud-label" data-state aria-live="polite">{t(locale, 'live.loading')}</p>
  <div class="grid" data-streams></div>
  {!compact && <h3 class="hud-label clips-h" data-clips-h hidden>{t(locale, 'live.clips')}</h3>}
  {!compact && <div class="grid" data-clips></div>}
  <p class="more"><a href={CATEGORY} rel="noopener noreferrer" target="_blank">{t(locale, 'live.openTwitch')}</a></p>
</div>

<script>
  type Stream = { login: string; name: string; title: string; viewers: number; thumbnail: string };
  type Clip = { id: string; title: string; broadcaster: string; views: number; thumbnail: string; url: string };
  type Live = { status: 'live' | 'offline' | 'unconfigured' | 'error'; streams: Stream[]; clips: Clip[] };

  const el = (tag: string, cls?: string, text?: string) => {
    const n = document.createElement(tag);
    if (cls) n.className = cls;
    if (text !== undefined) n.textContent = text;
    return n;
  };

  function card(opts: { thumb: string; title: string; who: string; extra: string; badge?: string; href: string; label: string; embed: () => string; s: Record<string, string> }) {
    const fig = el('figure', 'lc');
    const frame = el('div', 'frame');
    const btn = el('button', 'play') as HTMLButtonElement;
    btn.type = 'button';
    btn.setAttribute('aria-label', `${opts.label} ${opts.who}`);
    const img = el('img') as HTMLImageElement;
    img.src = opts.thumb;
    img.alt = '';
    img.loading = 'lazy';
    img.referrerPolicy = 'no-referrer';
    img.width = 440;
    img.height = 248;
    btn.append(img, el('span', 'icon', '▶'));
    if (opts.badge) btn.append(el('span', 'badge', opts.badge));
    btn.append(el('span', 'views', opts.extra));
    btn.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = opts.embed();
      f.title = `${opts.who} — Twitch`;
      f.allow = 'autoplay; fullscreen';
      f.allowFullscreen = true;
      btn.replaceWith(f);
    });
    frame.append(btn);
    const cap = el('figcaption');
    cap.append(el('span', 'lt', opts.title), el('span', 'who', opts.who));
    const a = el('a', 'tw', opts.s.onTwitch) as HTMLAnchorElement;
    a.href = opts.href;
    a.rel = 'noopener noreferrer';
    a.target = '_blank';
    cap.append(a);
    fig.append(frame, cap);
    return fig;
  }

  document.querySelectorAll<HTMLElement>('[data-live]').forEach(async (root) => {
    const s = JSON.parse(root.dataset.strings ?? '{}') as Record<string, string>;
    const max = Number(root.dataset.max ?? 12);
    const state = root.querySelector<HTMLElement>('[data-state]')!;
    const streamsEl = root.querySelector<HTMLElement>('[data-streams]')!;
    const clipsEl = root.querySelector<HTMLElement>('[data-clips]');
    const clipsH = root.querySelector<HTMLElement>('[data-clips-h]');
    // Twitch requires the embedding page's exact hostname as `parent`.
    const parent = encodeURIComponent(location.hostname);
    const nf = new Intl.NumberFormat(s.locale);
    let data: Live;
    try {
      const res = await fetch('/api/live', { headers: { accept: 'application/json' } });
      if (!res.ok) throw new Error(String(res.status));
      data = (await res.json()) as Live;
    } catch {
      data = { status: 'error', streams: [], clips: [] };
    }
    root.dataset.status = data.status;
    if (data.status === 'live') state.hidden = true;
    else state.textContent = data.status === 'offline' ? s.offline : s.unavailable;

    for (const x of data.streams.slice(0, max)) {
      streamsEl.append(
        card({
          thumb: x.thumbnail,
          title: x.title,
          who: x.name,
          extra: (s.viewers ?? '{n}').replace('{n}', nf.format(x.viewers)),
          badge: s.badge,
          href: `https://www.twitch.tv/${encodeURIComponent(x.login)}`,
          label: s.play,
          embed: () => `https://player.twitch.tv/?channel=${encodeURIComponent(x.login)}&parent=${parent}&autoplay=true`,
          s,
        }),
      );
    }
    if (clipsEl && data.clips.length) {
      if (clipsH) clipsH.hidden = false;
      for (const c of data.clips.slice(0, 8)) {
        clipsEl.append(
          card({
            thumb: c.thumbnail,
            title: c.title,
            who: c.broadcaster,
            extra: `▶ ${nf.format(c.views)}`,
            href: c.url,
            label: s.play,
            embed: () => `https://clips.twitch.tv/embed?clip=${encodeURIComponent(c.id)}&parent=${parent}&autoplay=true`,
            s,
          }),
        );
      }
    }
  });
</script>

<style>
  .state {
    color: var(--ink-soft);
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
  }
  [data-status='error'] .state,
  [data-status='unconfigured'] .state {
    color: var(--shd-ink);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    gap: var(--space-4);
  }
  .grid:empty {
    display: none;
  }
  .clips-h {
    margin: var(--space-5) 0 var(--space-2);
  }
  .more a {
    display: inline-block;
    padding: 8px 0;
    color: var(--shd-ink);
    font-weight: 700;
  }
  .live :global(.lc) {
    margin: 0;
  }
  .live :global(.frame) {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 1.5px solid var(--rule);
    overflow: hidden;
  }
  .live :global(.play),
  .live :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    padding: 0;
    background: #000;
    cursor: pointer;
  }
  .live :global(.play img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .live :global(.icon) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #9146ff;
    color: #fff;
    font-size: 22px;
  }
  .live :global(.badge) {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 2px 6px;
    background: #e91916;
    color: #fff;
    font: 600 0.75rem / 1.4 var(--font-hud);
  }
  .live :global(.views) {
    position: absolute;
    bottom: 8px;
    left: 8px;
    padding: 2px 6px;
    background: rgb(0 0 0 / 0.8);
    color: #fff;
    font: 400 0.75rem / 1.4 var(--font-hud);
  }
  .live :global(figcaption) {
    display: grid;
    gap: 2px;
    padding-top: 6px;
  }
  .live :global(.lt) {
    font: 700 var(--step-0) / 1.3 var(--font-display);
    overflow-wrap: anywhere;
  }
  .live :global(.who),
  .live :global(.tw) {
    font: 400 var(--step--1) / 1.5 var(--font-hud);
    color: var(--ink-soft);
  }
  .live :global(.tw) {
    display: inline-block;
    padding: 4px 0;
  }
</style>
