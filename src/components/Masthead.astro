---
import Hex from './Hex.astro';
import { formatDate, isZh, t, type Locale } from '../i18n/index.ts';
import LangMenu from './LangMenu.astro';
import { weatherFor } from '../lib/editions.ts';
import { routes } from '../lib/routes.ts';
import type { Edition } from '../schema/item.ts';
import { library } from '../lib/images.ts';
import { sourceZh } from '../lib/zh.ts';
import { OWNER_CHANNEL } from '../lib/owner.ts';

interface Props {
  locale: Locale;
  edition: Edition;
}
const { locale, edition } = Astro.props;
const dateIso = `${edition.date}T12:00:00+08:00`;
/** Last robot run, Taiwan/Hong Kong time (UTC+8) (the paper refreshes every 3 hours). */
const updatedAt = edition.generatedAt && !edition.fixture
  ? new Intl.DateTimeFormat(locale === 'en' ? 'en-GB' : 'zh-Hant-TW', { timeZone: 'Asia/Taipei', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(edition.generatedAt))
  : null;
/** Banner backgrounds: official key art + in-game screenshots (no news thumbnails, they carry text). */
const bgPool = library.images
  .filter((i) => i.tags?.some((tag) => tag === 'screenshot' || tag === 'keyart'))
  .map((i) => ({
    id: i.id,
    url: i.url,
    small: i.urlSmall ?? i.url,
    alt: locale === 'en' ? i.alt_en : i.alt_zhHant,
    credit: locale === 'en' ? i.attribution : sourceZh(i.attribution),
    creditUrl: i.attributionUrl,
  }));
const season = edition.meta ? (locale === 'en' ? edition.meta.season_en : edition.meta.season_zhHant) : null;
/** Ubisoft's official live status page, in the reader's language. */
const statusPage = `https://www.ubisoft.com/${locale === 'en' ? 'en-us' : 'zh-tw'}/game/the-division/the-division-2/status`;
const srvLabels = JSON.stringify({
  normal: t(locale, 'srv.normal'), normalTip: t(locale, 'srv.normalTip'), scheduled: t(locale, 'srv.scheduled'),
  maintenance: t(locale, 'srv.maintenance'), until: t(locale, 'srv.until'), unknown: t(locale, 'srv.unknown'), tip: t(locale, 'srv.tip'),
});
---
<!-- Phone: compact sticky bar -->
<div class="bar" data-bar>
  <a class="bar-home" href={`/${locale}/`}><Hex size={28} /><span>{t(locale, 'site.name')}</span></a>
  <a class="chip-btn" href={routes.search(locale)} aria-label={t(locale, 'nav.search')}>⌕</a>
  <a class="chip-btn" href={routes.favorites(locale)} aria-label={t(locale, 'fav.page')}>☆</a>
  <LangMenu locale={locale} />
  <button class="chip-btn" type="button" data-theme-toggle aria-label={t(locale, 'theme.toggle')}>◐</button>
</div>

<header class="masthead">
  <div class="title" data-banner={JSON.stringify(bgPool)}>
    <!-- Server status: from 巴哈's maintenance announcements (/api/server-status); links to Ubisoft's live page. -->
    <a class="srv s-unknown" data-srv data-labels={srvLabels} href={statusPage} target="_blank" rel="noopener noreferrer" title={t(locale, 'srv.tip')}>
      <span class="srv-dot" aria-hidden="true"></span><span class="srv-text">{t(locale, 'srv.unknown')}</span><span aria-hidden="true"> ↗</span>
    </a>
    <p class="title-name">
      <button type="button" class="hex-btn" data-hex aria-label={t(locale, 'egg.scan')}><Hex size={52} /></button>
      <span>{locale === 'en' ? 'The DC Dispatch' : '華盛頓每日快報'}</span>
    </p>
    {locale === 'en' && <p class="zhname" lang="zh-Hant-TW">華盛頓每日快報</p>}
    <p class="tag">“{t(locale, 'site.tagline')}”</p>
    <span class="corner tl" aria-hidden="true"></span><span class="corner br" aria-hidden="true"></span>
    <p class="bg-credit" hidden>{t(locale, 'photo.credit')}: <a rel="noopener noreferrer" target="_blank"></a></p>
  </div>
  <dl class="rail">
    <div><dt>{t(locale, 'rail.edition')}</dt><dd>{t(locale, 'edition.number')} {String(edition.editionNumber).padStart(3, '0')}{isZh(locale) ? ' 期' : ''}</dd></div>
    <div><dt>{t(locale, 'rail.date')}</dt><dd><time datetime={edition.date}>{formatDate(dateIso, locale)}</time></dd></div>
    {updatedAt && <div><dt>{t(locale, 'rail.updated')}</dt><dd><time datetime={edition.generatedAt}>{updatedAt}</time> <small class="tz">{t(locale, 'rail.tz')}</small></dd></div>}
    {season && <div><dt>{t(locale, 'rail.season')}</dt><dd>{season} · {edition.meta?.titleUpdate}</dd></div>}
    <div><dt>{t(locale, 'rail.weather')}</dt><dd>{weatherFor(edition.date, locale)}</dd></div>
    <div data-views hidden data-fmt={t(locale, 'rail.viewsFmt')}><dt>{t(locale, 'rail.views')}</dt><dd>—</dd></div>
    <div class="rail-tools">
      <a class="chip-btn" href={routes.favorites(locale)}>☆ {t(locale, 'fav.page')}</a>
      <LangMenu locale={locale} />
      <button class="chip-btn" type="button" data-theme-toggle aria-label={t(locale, 'theme.toggle')}>
        <span class="when-day">◐ {t(locale, 'theme.night')}</span><span class="when-night">◑ {t(locale, 'theme.day')}</span>
      </button>
    </div>
    <div class="rail-yt">
      <a class="yt" href={OWNER_CHANNEL} target="_blank" rel="noopener noreferrer"><span class="yt-play" aria-hidden="true">▶</span>{t(locale, 'owner.youtube')} ↗</a>
    </div>
  </dl>
</header>

<script>
  // Server status badge (see /api/server-status). Times shown in Taiwan/Hong Kong time.
  {
    const srv = document.querySelector<HTMLAnchorElement>('[data-srv]');
    if (srv) {
      const L = JSON.parse(srv.dataset.labels ?? '{}') as Record<string, string>;
      const text = srv.querySelector<HTMLElement>('.srv-text')!;
      const fmt = (iso: string, withDate: boolean) =>
        new Intl.DateTimeFormat(document.documentElement.lang.startsWith('en') ? 'en-GB' : 'zh-Hant-TW', {
          timeZone: 'Asia/Taipei', hour: '2-digit', minute: '2-digit', hour12: false, ...(withDate ? { month: 'numeric', day: 'numeric' } : {}),
        }).format(new Date(iso));
      type S = { state: string; start?: string; end?: string };
      let timer: number | undefined;
      const show = (s: S) => {
        const now = Date.now();
        // Announced times pass while the page is open: switch on the minute, without waiting for a re-check.
        if (s.state === 'scheduled' && s.start && now >= Date.parse(s.start)) s = { ...s, state: 'maintenance' };
        if (s.state === 'maintenance' && s.end && now >= Date.parse(s.end)) s = { state: 'normal' };
        srv.className = `srv s-${s.state}`;
        if (s.state === 'scheduled') text.textContent = L.scheduled!.replace('{time}', fmt(s.start!, true));
        else if (s.state === 'maintenance') text.textContent = s.end ? `${L.maintenance} · ${L.until!.replace('{time}', fmt(s.end, false))}` : L.maintenance!;
        else text.textContent = s.state === 'normal' ? L.normal! : L.unknown!;
        srv.title = s.state === 'normal' ? L.normalTip! : L.tip!;
        clearTimeout(timer);
        const next = s.state === 'scheduled' ? s.start : s.state === 'maintenance' ? s.end : undefined;
        if (next) {
          const wait = Date.parse(next) - Date.now();
          if (wait > 0 && wait < 2 ** 31 - 1) timer = window.setTimeout(() => show(s), wait + 500);
        }
      };
      const check = () =>
        fetch('/api/server-status')
          .then((r) => (r.ok ? r.json() : null))
          .then((s: S | null) => s && show(s))
          .catch(() => {});
      check();
      window.setInterval(check, 5 * 60_000);
    }
  }
  // Random Division 2 picture behind the masthead on every visit (never the same one twice in a row).
  (() => {
    const box = document.querySelector<HTMLElement>('.masthead .title[data-banner]');
    if (!box) return;
    let pool: { id: string; url: string; small: string; alt: string; credit: string; creditUrl: string }[] = [];
    try {
      pool = JSON.parse(box.dataset.banner ?? '[]');
    } catch {}
    if (!pool.length) return;
    let last = '';
    try {
      last = localStorage.getItem('dcd.bannerBg') ?? '';
    } catch {}
    const choices = pool.length > 1 ? pool.filter((p) => p.id !== last) : pool;
    const pick = choices[Math.floor(Math.random() * choices.length)]!;
    try {
      localStorage.setItem('dcd.bannerBg', pick.id);
    } catch {}
    const src = window.innerWidth < 700 ? pick.small : pick.url;
    const img = new Image();
    img.onload = () => {
      box.style.setProperty('--banner', `url("${src}")`);
      box.classList.add('has-bg');
      const credit = box.querySelector<HTMLElement>('.bg-credit');
      const a = credit?.querySelector('a');
      if (credit && a) {
        a.href = pick.creditUrl;
        a.textContent = `${pick.credit} ↗`;
        credit.hidden = false;
      }
    };
    img.referrerPolicy = 'no-referrer';
    img.src = src;
  })();

  // View counter (functions/api/views.ts). Hidden unless the counter answers.
  const box = document.querySelector<HTMLElement>('[data-views]');
  if (box) {
    fetch('/api/views', { headers: { accept: 'application/json' }, credentials: 'same-origin' })
      .then((r) => (r.ok ? r.json() : null))
      .then((v: { status?: string; total?: number; today?: number } | null) => {
        if (!v || v.status !== 'ok') return;
        const n = (x = 0) => x.toLocaleString(document.documentElement.lang || undefined);
        box.querySelector('dd')!.textContent = (box.dataset.fmt ?? '{total}').replace('{total}', n(v.total)).replace('{today}', n(v.today));
        box.hidden = false;
      })
      .catch(() => {});
  }
</script>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: calc(var(--bar-h) + env(safe-area-inset-top));
    padding: env(safe-area-inset-top) max(12px, env(safe-area-inset-right)) 0 max(12px, env(safe-area-inset-left));
    background: var(--paper);
    border-bottom: 2px solid var(--shd);
  }
  .bar-home {
    flex: 1;
    min-width: 0;
    min-height: var(--tap);
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    font: 900 1.25rem / 1 var(--font-display);
    white-space: nowrap;
  }
  .bar-home span {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .masthead {
    display: grid;
    grid-template-columns: 1fr;
    max-width: var(--max);
    margin-inline: auto;
    border-bottom: 2px solid var(--rule);
  }
  .title {
    position: relative;
    padding: 20px var(--gutter) 14px;
  }
  /* Server status badge: small, top right of the banner. */
  .srv {
    position: absolute;
    top: 8px;
    right: var(--gutter);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 999px;
    background: rgb(12 13 14 / 0.72);
    color: #f2f2f2;
    font: 600 var(--step--1) / 1.3 var(--font-hud);
    text-decoration: none;
    white-space: nowrap;
  }
  .srv:hover {
    border-color: #f2f2f2;
  }
  .srv-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #8a8f98;
  }
  .s-normal .srv-dot {
    background: #2ee59d;
    box-shadow: 0 0 6px #2ee59d;
  }
  .s-scheduled .srv-dot {
    background: #f5c518;
  }
  .s-maintenance .srv-dot {
    background: #ff6a00;
    box-shadow: 0 0 6px #ff6a00;
  }
  /* Random banner picture: dark shade on the left so the nameplate stays readable in Day and Night. */
  .title.has-bg {
    min-height: clamp(150px, 22vw, 280px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background:
      linear-gradient(90deg, rgb(12 13 14 / 0.86) 0%, rgb(12 13 14 / 0.6) 45%, rgb(12 13 14 / 0.15) 100%),
      linear-gradient(0deg, rgb(12 13 14 / 0.55) 0%, transparent 45%),
      var(--banner) center / cover no-repeat;
    color: #f3eee3;
    animation: banner-in 0.6s ease-out;
  }
  .title.has-bg .title-name,
  .title.has-bg .tag,
  .title.has-bg .zhname {
    color: #f3eee3;
    text-shadow: 0 2px 8px rgb(0 0 0 / 0.6);
  }
  @keyframes banner-in {
    from {
      opacity: 0.4;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .title.has-bg {
      animation: none;
    }
  }
  .bg-credit {
    position: absolute;
    right: 18px;
    top: 6px;
    margin: 0;
    font: 400 0.6875rem / 1.4 var(--font-hud);
    color: rgb(243 238 227 / 0.85);
  }
  .bg-credit a {
    color: inherit;
  }
  .bg-credit[hidden] {
    display: none;
  }
  .title-name {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font: 900 var(--step-4) / 0.95 var(--font-display);
    letter-spacing: -0.01em;
  }
  .hex-btn {
    flex: none;
    display: grid;
    place-items: center;
    min-width: var(--tap);
    min-height: var(--tap);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .masthead {
    position: relative;
  }
  /* HUD scan line: on first paint over the rail, and when the hex is tapped */
  .masthead::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 0, rgb(255 109 16 / 0.18) 48%, var(--shd) 50%, rgb(255 109 16 / 0.18) 52%, transparent 100%) no-repeat;
    background-size: 100% 60px;
    background-position: 0 -60px;
    opacity: 0;
  }
  :global(.scanning) .masthead::after,
  .masthead:global(.scanning)::after {
    animation: scan 1.1s ease-in-out;
  }
  @keyframes scan {
    0% { opacity: 1; background-position: 0 -60px; }
    100% { opacity: 1; background-position: 0 calc(100% + 60px); }
  }
  .rail {
    /* 'backwards', not 'both': no clip left after the animation, so the language menu can open below the rail. */
    animation: scanin 0.7s ease-out backwards;
  }
  @keyframes scanin {
    from { clip-path: inset(0 0 100% 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  .zhname {
    margin: 8px 0 0;
    font: 900 clamp(1.15rem, 0.9rem + 1.4vw, 1.75rem) / 1.4 var(--font-cjk);
    letter-spacing: 0.25em;
  }
  .tag {
    margin: 4px 0 0;
    font: italic var(--step-0) / 1.4 var(--font-body);
    color: var(--ink-soft);
  }
  .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 2px solid var(--shd);
  }
  .tl {
    top: 8px;
    left: 8px;
    border-right: 0;
    border-bottom: 0;
  }
  .br {
    bottom: 8px;
    right: 8px;
    border-left: 0;
    border-top: 0;
  }

  .rail {
    position: relative;
    margin: 0;
    padding: 12px var(--gutter);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px 12px;
    background: var(--panel);
    color: var(--panel-ink);
    border-top: 3px solid var(--shd);
    font: 400 0.875rem / 1.5 var(--font-hud);
  }
  .rail::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(0deg, rgb(255 255 255 / 0.04) 0 1px, transparent 1px 3px);
  }
  .rail > div {
    display: contents;
  }
  .rail > div[hidden] {
    display: none;
  }
  .rail dt {
    color: var(--shd);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding-top: 2px;
  }
  .rail dd {
    margin: 0;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .rail .tz {
    opacity: 0.7;
    font-size: 0.75rem;
  }
  .rail > .rail-yt {
    grid-column: 1 / -1;
    display: block;
    margin-top: 8px;
    position: relative;
    z-index: 1;
  }
  .yt {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: var(--tap);
    padding: 4px 10px;
    background: #c4302b;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    border: 1.5px solid #c4302b;
  }
  .yt:hover,
  .yt:focus-visible {
    background: #a32622;
    color: #fff;
  }
  .yt-play {
    font-size: 0.8em;
  }
  .rail > .rail-tools {
    grid-column: 1 / -1;
    display: flex;
    gap: 8px;
    margin-top: 8px;
    position: relative;
    z-index: 30; /* above the ticker and section nav, for the language menu */
  }
  :root[data-theme='night'] .when-day,
  :root:not([data-theme='night']) .when-night {
    display: none;
  }

  @media (min-width: 768px) {
    .bar {
      display: none;
    }
    .masthead {
      grid-template-columns: 1fr 290px;
      margin-top: var(--space-4);
      border-top: 2px solid var(--rule);
    }
    .title {
      padding: 24px 28px 16px;
      border-right: 2px solid var(--rule);
    }
    .rail {
      border-top: 0;
      border-left: 3px solid var(--shd);
      padding: 14px 16px;
      grid-template-columns: 1fr;
      align-content: start;
      gap: 0;
    }
    .rail dd {
      margin-bottom: 8px;
    }
  }
  @media (max-width: 767.98px) {
    .title {
      padding: 14px var(--gutter) 10px;
    }
    .title-name {
      font-size: clamp(2.1rem, 10vw, 2.75rem);
    }
    .zhname {
      margin-top: 4px;
      font-size: 1.1rem;
    }
    .tag {
      font-size: 0.9375rem;
    }
    .rail {
      padding: 8px var(--gutter);
      font-size: 0.8125rem;
      line-height: 1.45;
    }
    .hex-btn :global(.hex) {
      width: 36px;
      height: 42px;
    }
    .rail > .rail-tools {
      display: none; /* the sticky bar has the same buttons */
    }
  }
</style>
