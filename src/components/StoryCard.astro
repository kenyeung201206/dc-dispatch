---
import Stamp from './Stamp.astro';
import Photo from './Photo.astro';
import FavButton from './FavButton.astro';
import { formatDate, t, type Locale } from '../i18n/index.ts';
import { localized } from '../lib/editions.ts';
import { sourceZh } from '../lib/zh.ts';
import type { PlacedImage } from '../lib/images.ts';
import { routes } from '../lib/routes.ts';
import type { Item } from '../schema/item.ts';

interface Props {
  locale: Locale;
  item: Item;
  variant?: 'lead' | 'standard' | 'brief';
  photo?: PlacedImage | null;
}
const { locale, item, variant = 'standard', photo } = Astro.props;
const headline = localized(item, 'headline', locale);
const summary = localized(item, 'summary', locale);
const whyRaw = item.whyItMatters_en ? localized(item, 'whyItMatters', locale) : null;
// Chinese pages never show English: drop untranslated extras and the English original title.
const why = whyRaw && !(locale !== 'en' && whyRaw.pending) ? whyRaw : null;
const showOriginal = locale !== item.lang_orig.slice(0, 2) && locale === 'en';
const kind = (locale !== 'en' && item.summaryKind_zhHant) || item.summaryKind;
const src = (name: string) => (locale === 'en' ? name : sourceZh(name));
const H = variant === 'lead' ? 'h2' : 'h3';
const day = new Intl.DateTimeFormat(locale === 'en' ? 'en' : 'zh-Hant-TW', {
  timeZone: 'Asia/Taipei',
  month: 'short',
  day: 'numeric',
}).format(new Date(item.publishedAt));
---
<article class:list={['story', variant]} data-confidence={item.confidence}>
  {item.videoId && !photo && variant !== 'brief' && (
    <a class="vthumb" href={routes.story(locale, item.id)} aria-hidden="true" tabindex="-1">
      <img src={`https://i.ytimg.com/vi/${item.videoId}/mqdefault.jpg`} width="320" height="180" alt="" loading="lazy" referrerpolicy="no-referrer" />
      <span>▶</span>
    </a>
  )}
  {photo && variant !== 'brief' && (
    <Photo locale={locale} image={photo.image} filePhoto={photo.filePhoto} variant={variant === 'lead' ? 'lead' : 'card'} eager={variant === 'lead'} />
  )}
  <div class="meta">
    {item.firstSeenAt && <span class="newb" data-new-badge data-first-seen={item.firstSeenAt} hidden>{t(locale, 'badge.new')}</span>}
    <Stamp locale={locale} confidence={item.confidence} />
    {item.status === 'updated' && <span class="hud-label upd">{t(locale, 'status.updated')}</span>}
    <time class="hud-label" datetime={item.publishedAt} title={formatDate(item.publishedAt, locale)}>{day}</time>
    <FavButton locale={locale} id={item.id} />
  </div>
  <H class="headline" lang={headline.pending ? headline.lang : undefined}>
    <a href={routes.story(locale, item.id)}>{headline.text}</a>
  </H>
  {headline.pending && <p class="pending">{t(locale, 'translation.pending')}</p>}
  {variant !== 'brief' && item.confidence === 'rumour' && <p class="declass hud-label">{t(locale, 'story.declassify')}</p>}
  {variant !== 'brief' && (
    <p class:list={['summary', variant === 'lead' && kind !== 'extract' && 'dropcap', kind === 'extract' && 'quote']} lang={summary.pending ? summary.lang : undefined} tabindex={item.confidence === 'rumour' ? 0 : undefined}>
      {kind === 'extract' ? `“${summary.text}”` : summary.text}
      {kind === 'extract' && <span class="attrib"> — {src(item.sourceName)}</span>}
    </p>
  )}
  {why && variant !== 'brief' && (
    <p class="why">
      <strong>{t(locale, 'story.whyItMatters')}:</strong> <span lang={why.pending ? why.lang : undefined}>{why.text}</span>
    </p>
  )}
  {showOriginal && variant === 'lead' && (
    <p class="orig">
      {t(locale, 'story.original')}: <span lang={item.lang_orig}>{item.title_orig}</span>
    </p>
  )}
  <p class="source">
    {t(locale, 'story.source')}: <a href={item.sourceUrl} rel="noopener noreferrer" target="_blank">{src(item.sourceName)}</a>
    {item.alsoReportedBy.map((s) => (
      <>
        {' · '}
        <a href={s.url} rel="noopener noreferrer" target="_blank">{src(s.name)}</a>
      </>
    ))}
  </p>
</article>

<style>
  .story {
    padding-bottom: var(--space-4);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin-bottom: 6px;
    color: var(--ink-soft);
  }
  .upd {
    color: var(--shd-ink);
  }
  .headline a {
    text-decoration: none;
  }
  .headline a:hover {
    text-decoration: underline;
    text-decoration-color: var(--shd);
  }
  .headline {
    margin: 0 0 6px;
    font: 700 var(--step-1) / 1.2 var(--font-display);
    text-wrap: balance;
  }
  :lang(zh) .headline,
  .headline:lang(zh) {
    font-family: var(--font-cjk);
    font-weight: 900;
    line-height: 1.35;
  }
  .lead .headline {
    font-size: var(--step-3);
    font-weight: 900;
    line-height: 1.08;
  }
  .brief .headline {
    font-size: var(--step-0);
    font-family: var(--font-body);
  }
  .summary {
    margin: 0 0 8px;
    hyphens: auto;
  }
  .lead .summary {
    font-size: 1.125rem;
  }
  .dropcap:lang(en)::first-letter,
  :lang(en) .dropcap::first-letter {
    float: left;
    font: 900 3.4em / 0.8 var(--font-display);
    padding: 0.06em 0.08em 0 0;
    color: var(--shd-ink);
  }
  /* 首字強調 */
  :lang(zh) .dropcap::first-letter {
    font-weight: 900;
    font-size: 1.5em;
    color: var(--shd-ink);
  }
  /* Rumours: blurred until hovered, tapped (focus) or the card gets keyboard focus. Visual only. */
  [data-confidence='rumour'] .summary {
    filter: blur(4px);
    transition: filter 0.3s;
  }
  [data-confidence='rumour']:hover .summary,
  [data-confidence='rumour']:focus-within .summary {
    filter: none;
  }
  @media print {
    [data-confidence='rumour'] .summary {
      filter: none;
    }
  }
  .declass {
    margin: 0 0 4px;
    color: var(--dz-red);
    text-transform: none;
  }
  .vthumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    margin-bottom: var(--space-3);
    background: #000;
    border: 1.5px solid var(--rule);
    overflow: hidden;
  }
  .vthumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .vthumb span {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 48px;
    height: 34px;
    border-radius: 8px;
    background: rgb(33 33 33 / 0.85);
    color: #fff;
  }
  .quote {
    font-style: italic;
  }
  .attrib {
    font-style: normal;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .why {
    margin: 0 0 8px;
    padding-left: 10px;
    border-left: 3px solid var(--shd);
    font-size: 0.9375rem;
  }
  .orig,
  .source,
  .pending {
    margin: 0;
    font: 400 var(--step--1) / 1.5 var(--font-hud);
    color: var(--ink-soft);
  }
  .pending {
    color: var(--shd-ink);
  }
  .source a {
    display: inline-block;
    padding: 6px 0; /* larger tap target */
  }
</style>
