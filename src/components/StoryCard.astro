---
import Stamp from './Stamp.astro';
import Photo from './Photo.astro';
import { formatDate, t, type Locale } from '../i18n/index.ts';
import { localized } from '../lib/editions.ts';
import type { PlacedImage } from '../lib/images.ts';
import { routes } from '../lib/routes.ts';
import type { Item } from '../schema/item.ts';

interface Props {
  locale: Locale;
  item: Item;
  variant?: 'lead' | 'standard' | 'brief';
  photo?: PlacedImage | null;
}
const { locale, item, variant = 'standard', photo } = Astro.props;
const headline = localized(item, 'headline', locale);
const summary = localized(item, 'summary', locale);
const why = item.whyItMatters_en ? localized(item, 'whyItMatters', locale) : null;
const showOriginal = locale !== item.lang_orig.slice(0, 2);
const H = variant === 'lead' ? 'h2' : 'h3';
const day = new Intl.DateTimeFormat(locale === 'en' ? 'en' : 'zh-Hant-TW', {
  timeZone: 'Asia/Tokyo',
  month: 'short',
  day: 'numeric',
}).format(new Date(item.publishedAt));
---
<article class:list={['story', variant]} data-confidence={item.confidence}>
  {photo && variant !== 'brief' && (
    <Photo locale={locale} image={photo.image} filePhoto={photo.filePhoto} variant={variant === 'lead' ? 'lead' : 'card'} eager={variant === 'lead'} />
  )}
  <div class="meta">
    <Stamp locale={locale} confidence={item.confidence} />
    {item.status === 'updated' && <span class="hud-label upd">{t(locale, 'status.updated')}</span>}
    <time class="hud-label" datetime={item.publishedAt} title={formatDate(item.publishedAt, locale)}>{day}</time>
  </div>
  <H class="headline" lang={headline.pending ? 'en' : undefined}>
    <a href={routes.story(locale, item.id)}>{headline.text}</a>
  </H>
  {headline.pending && <p class="pending">{t(locale, 'translation.pending')}</p>}
  {variant !== 'brief' && item.confidence === 'rumour' && <p class="declass hud-label">{t(locale, 'story.declassify')}</p>}
  {variant !== 'brief' && (
    <p class:list={['summary', variant === 'lead' && item.summaryKind !== 'extract' && 'dropcap', item.summaryKind === 'extract' && 'quote']} lang={summary.pending ? 'en' : undefined} tabindex={item.confidence === 'rumour' ? 0 : undefined}>
      {item.summaryKind === 'extract' ? `“${summary.text}”` : summary.text}
      {item.summaryKind === 'extract' && <span class="attrib"> — {item.sourceName}</span>}
    </p>
  )}
  {why && variant !== 'brief' && (
    <p class="why">
      <strong>{t(locale, 'story.whyItMatters')}:</strong> <span lang={why.pending ? 'en' : undefined}>{why.text}</span>
    </p>
  )}
  {showOriginal && variant === 'lead' && (
    <p class="orig">
      {t(locale, 'story.original')}: <span lang={item.lang_orig}>{item.title_orig}</span>
    </p>
  )}
  <p class="source">
    {t(locale, 'story.source')}: <a href={item.sourceUrl} rel="noopener noreferrer" target="_blank">{item.sourceName}</a>
    {item.alsoReportedBy.map((s) => (
      <>
        {' · '}
        <a href={s.url} rel="noopener noreferrer" target="_blank">{s.name}</a>
      </>
    ))}
  </p>
</article>

<style>
  .story {
    padding-bottom: var(--space-4);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin-bottom: 6px;
    color: var(--ink-soft);
  }
  .upd {
    color: var(--shd-ink);
  }
  .headline a {
    text-decoration: none;
  }
  .headline a:hover {
    text-decoration: underline;
    text-decoration-color: var(--shd);
  }
  .headline {
    margin: 0 0 6px;
    font: 700 var(--step-1) / 1.2 var(--font-display);
    text-wrap: balance;
  }
  :lang(zh-Hant-TW) .headline,
  .headline:lang(zh-Hant-TW) {
    font-family: var(--font-cjk);
    font-weight: 900;
    line-height: 1.35;
  }
  .lead .headline {
    font-size: var(--step-3);
    font-weight: 900;
    line-height: 1.08;
  }
  .brief .headline {
    font-size: var(--step-0);
    font-family: var(--font-body);
  }
  .summary {
    margin: 0 0 8px;
    hyphens: auto;
  }
  .lead .summary {
    font-size: 1.125rem;
  }
  .dropcap:lang(en)::first-letter,
  :lang(en) .dropcap::first-letter {
    float: left;
    font: 900 3.4em / 0.8 var(--font-display);
    padding: 0.06em 0.08em 0 0;
    color: var(--shd-ink);
  }
  /* 首字強調 */
  :lang(zh-Hant-TW) .dropcap::first-letter {
    font-weight: 900;
    font-size: 1.5em;
    color: var(--shd-ink);
  }
  /* Rumours: blurred until hovered, tapped (focus) or the card gets keyboard focus. Visual only. */
  [data-confidence='rumour'] .summary {
    filter: blur(4px);
    transition: filter 0.3s;
  }
  [data-confidence='rumour']:hover .summary,
  [data-confidence='rumour']:focus-within .summary {
    filter: none;
  }
  @media print {
    [data-confidence='rumour'] .summary {
      filter: none;
    }
  }
  .declass {
    margin: 0 0 4px;
    color: var(--dz-red);
    text-transform: none;
  }
  .quote {
    font-style: italic;
  }
  .attrib {
    font-style: normal;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .why {
    margin: 0 0 8px;
    padding-left: 10px;
    border-left: 3px solid var(--shd);
    font-size: 0.9375rem;
  }
  .orig,
  .source,
  .pending {
    margin: 0;
    font: 400 var(--step--1) / 1.5 var(--font-hud);
    color: var(--ink-soft);
  }
  .pending {
    color: var(--shd-ink);
  }
  .source a {
    display: inline-block;
    padding: 6px 0; /* larger tap target */
  }
</style>
