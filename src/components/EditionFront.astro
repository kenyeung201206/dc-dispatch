---
import DailyLoot from './DailyLoot.astro';
import StoryCard from './StoryCard.astro';
import SideBox from './SideBox.astro';
import LeadArt from './LeadArt.astro';
import Photo from './Photo.astro';
import { CATEGORIES, type Category } from '../schema/item.ts';
import { t, type Locale, type UiKey } from '../i18n/index.ts';
import type { Edition } from '../schema/item.ts';
import { allItems, byImportance, latestEdition, localized, readableIn } from '../lib/editions.ts';
import { routes } from '../lib/routes.ts';
import VideoFacade from './VideoFacade.astro';
import LiveNow from './LiveNow.astro';
import BackPage from './BackPage.astro';
import ExoticIntel from './ExoticIntel.astro';
import GuidePicks from './GuidePicks.astro';
import HotTopics from './HotTopics.astro';
import { agentOfTheDay, humourLevel } from '../lib/humour.ts';
import { videoOfTheDay, videosFor } from '../lib/videos.ts';
import { bannerFor, imageFor } from '../lib/images.ts';

interface Props {
  locale: Locale;
  edition: Edition;
}
const { locale, edition } = Astro.props;
const items = edition.items.filter((i) => readableIn(i, locale)).sort(byImportance);

/**
 * 最新更新 — a table of contents of the last week's arrivals, newest first, grouped by day.
 * The first LATEST_FIRST rows show; 顯示更多 opens LATEST_STEP more at a time.
 */
const LATEST_FIRST = 6;
const LATEST_STEP = 10;
const LATEST_MAX = 50;
const weekAgo = new Date(Date.parse(edition.generatedAt) - 7 * 86_400_000).toISOString();
// A past day's page shows that day's updates as they were then (not today's), so the archive reads as that day.
const isPast = edition.date !== latestEdition().date;
const latest = allItems
  .filter((i) => readableIn(i, locale) && i.firstSeenAt && i.firstSeenAt >= weekAgo && i.firstSeenAt <= edition.generatedAt)
  .sort((a, b) => b.firstSeenAt!.localeCompare(a.firstSeenAt!) || byImportance(a, b))
  .slice(0, LATEST_MAX);
const fmt = (o: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat(locale === 'en' ? 'en-GB' : 'zh-Hant-TW', { timeZone: 'Asia/Tokyo', ...o });
const dayKey = (iso: string) => fmt({ year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(iso));
const dayLabel = (iso: string) => fmt({ month: 'long', day: 'numeric', weekday: 'short' }).format(new Date(iso));
const clock = (iso: string) => fmt({ hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(iso));
/** Rows in order: a day heading whenever the date changes, then that day's stories (n = story position). */
const latestRows: ({ kind: 'day'; label: string; n: number } | { kind: 'item'; item: (typeof latest)[number]; n: number })[] = [];
latest.forEach((item, n) => {
  const prev = latest[n - 1];
  if (!prev || dayKey(prev.firstSeenAt!) !== dayKey(item.firstSeenAt!)) latestRows.push({ kind: 'day', label: dayLabel(item.firstSeenAt!), n });
  latestRows.push({ kind: 'item', item, n });
});

const [lead, ...rest] = items;
const secondary = rest.slice(0, 3);
const frontIds = new Set([lead!.id, ...secondary.map((i) => i.id)]);

// Section blocks below the fold (Watch Now + Back Page come in later phases).
const SECTION_ORDER = CATEGORIES.filter((c) => !['front-page', 'watch-now', 'back-page'].includes(c));
const bySection = (c: Category) => items.filter((i) => i.category === c && !frontIds.has(i.id));

const glitches = items.filter((i) => i.glitch);
const patchTldr = items.filter((i) => i.category === 'updates').slice(0, 4);

// Pictures: stories' own images are reserved first, then section banners,
// then gameplay "file photos" for stories without one — no picture repeats on the page.
const used = new Set(items.flatMap((i) => (i.imageId ? [i.imageId] : [])));
const banners = new Map(SECTION_ORDER.map((c) => [c, bannerFor(c, used)]));
const photos = new Map(items.map((i) => [i.id, imageFor(i, used)]));
const leadPhoto = photos.get(lead!.id);
const vod = videoOfTheDay(locale);
const moreVideos = videosFor(locale).filter((v) => v.id !== vod?.id).slice(0, 2);
---
  {edition.fixture && <p class="fixture-note hud-label">{t(locale, 'edition.fixture')}</p>}

  <h1 class="visually-hidden">{t(locale, 'site.name')} — {t(locale, 'section.front-page')}</h1>

  {
    latest.length > 0 && (
      <section class="latest" aria-labelledby="latest-h">
        <h2 id="latest-h" class="hud-label">{!isPast && <span class="pulse" aria-hidden="true" />}{t(locale, isPast ? 'latest.titlePast' : 'latest.title')}</h2>
        <ol data-latest data-first={LATEST_FIRST} data-step={LATEST_STEP}>
          {latestRows.map((r) =>
            r.kind === 'day' ? (
              <li class="day" data-n={r.n} hidden={r.n >= LATEST_FIRST} aria-hidden="true">{r.label}</li>
            ) : (
              <li data-n={r.n} hidden={r.n >= LATEST_FIRST}>
                <p class="lm">
                  <span class="newb" data-new-badge data-first-seen={r.item.firstSeenAt} hidden>{t(locale, 'badge.new')}</span>
                  <time class="hud-label" datetime={r.item.firstSeenAt}>{clock(r.item.firstSeenAt!)}</time>
                  <span class="sec">· {t(locale, `section.${r.item.category}` as UiKey)}</span>
                </p>
                <a href={routes.story(locale, r.item.id)}>{localized(r.item, 'headline', locale).text}</a>
              </li>
            ),
          )}
        </ol>
        {
          latest.length > LATEST_FIRST && (
            <button type="button" class="more-btn" data-latest-more aria-expanded="false" data-more={t(locale, 'latest.more')} data-less={t(locale, 'latest.less')}>
              {t(locale, 'latest.more').replace('{n}', String(Math.min(LATEST_STEP, latest.length - LATEST_FIRST)))}
            </button>
          )
        }
      </section>
    )
  }

  {!isPast && <DailyLoot locale={locale} date={edition.date} />}

  <div class="front" id="front-page">
    <div class="lead-col">
      {!leadPhoto && <LeadArt />}
      <StoryCard locale={locale} item={lead!} variant="lead" photo={leadPhoto} />
      <div class="secondary">
        {secondary.map((item) => <StoryCard locale={locale} item={item} photo={photos.get(item.id)} />)}
      </div>
    </div>

    <aside class="side" aria-label={t(locale, 'sidebar.glitch')}>
      <SideBox title={t(locale, 'sidebar.glitch')} tone="hazard">
        <ul class="glitch-list">
          {
            glitches.map((g) => (
              <li>
                <span class:list={['gstate', g.glitch!.state]}>{t(locale, `glitch.${g.glitch!.state}`)}</span>
                <a href={routes.story(locale, g.id)}>{localized(g, 'headline', locale).text}</a>
                {g.glitch!.banRisk && <strong class="ban">{t(locale, 'glitch.banRisk')}</strong>}
                <small>{locale === 'en' ? g.glitch!.riskNote_en : g.glitch!.riskNote_zhHant === 'pending' ? g.glitch!.riskNote_en : g.glitch!.riskNote_zhHant}</small>
              </li>
            ))
          }
        </ul>
      </SideBox>
      {!isPast && <SideBox title={t(locale, 'hot.title')}>
        <HotTopics locale={locale} />
      </SideBox>}
      <SideBox title={t(locale, 'guides.title')}>
        <GuidePicks locale={locale} limit={4} />
      </SideBox>
      <SideBox title={t(locale, 'exotic.title')}>
        <ExoticIntel locale={locale} limit={5} />
      </SideBox>
      <SideBox title={t(locale, 'sidebar.patch')}>
        <ul class="tldr">
          {patchTldr.map((p) => <li><a href={routes.story(locale, p.id)}>{localized(p, 'headline', locale).text}</a></li>)}
          <li class="more"><a href={routes.patches(locale)}>{t(locale, 'nav.patches')} →</a></li>
        </ul>
      </SideBox>
      {humourLevel() !== 'light' && <SideBox title={t(locale, 'sidebar.agent')} tone="satire" satireLabel={t(locale, 'satire.label')}>
        <p class="satire-text">{agentOfTheDay(locale, edition.date)}</p>
      </SideBox>}
    </aside>
  </div>

  {
    SECTION_ORDER.map((c) => {
      const list = bySection(c);
      const banner = banners.get(c);
      return (
        <section id={c} class="sec" aria-labelledby={`h-${c}`}>
          <header class="section-head">
            <h2 id={`h-${c}`}><a href={routes.section(locale, c)}>{t(locale, `section.${c}` as UiKey)}</a></h2>
            <p>{t(locale, `tagline.${c}` as UiKey)}</p>
          </header>
          {banner && <Photo locale={locale} image={banner} variant="banner" />}
          {list.length ? (
            <div class="cols">
              {list.map((item) => <StoryCard locale={locale} item={item} photo={photos.get(item.id)} />)}
            </div>
          ) : (
            <p class="empty">{t(locale, 'empty.section')}</p>
          )}
        </section>
      );
    })
  }

  <section id="watch-now" class="sec watch" aria-labelledby="h-watch">
    <header class="section-head">
      <h2 id="h-watch"><a href={routes.watch(locale)}>{t(locale, 'watch.title')}</a></h2>
      <p>{t(locale, 'watch.tagline')}</p>
    </header>
    <div class="watch-grid">
      {vod && <div class="wv"><p class="hud-label">{t(locale, 'watch.vod')}</p><VideoFacade locale={locale} video={vod} size="large" /></div>}
      <div class="wside">
        {moreVideos.map((v) => <VideoFacade locale={locale} video={v} />)}
        <p class="hud-label">{t(locale, 'live.title')}</p>
        <LiveNow locale={locale} compact />
        <p><a class="all" href={routes.watch(locale)}>{t(locale, 'watch.all')}</a></p>
      </div>
    </div>
  </section>

  <BackPage locale={locale} edition={edition} />

<style>
  .latest {
    margin: var(--space-4) 0;
    padding: 10px 14px;
    border: 2px solid var(--ink);
    border-left: 8px solid var(--shd);
    background: color-mix(in srgb, var(--paper-2) 70%, transparent);
  }
  .latest h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 6px;
    color: var(--shd-ink);
  }
  .pulse {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--shd);
    animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
    }
  }
  .latest ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .latest li {
    padding: 8px 0;
    border-top: 1px dashed var(--rule-soft);
  }
  .lm {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0 0 2px;
  }
  .latest li:first-child {
    border-top: 0;
  }
  .latest li[hidden] {
    display: none;
  }
  .latest li.day {
    margin-top: 6px;
    padding: 6px 0 2px;
    border-top: 2px solid var(--rule);
    font: 700 0.8125rem / 1.3 var(--font-hud);
    letter-spacing: 0.04em;
    color: var(--shd-ink);
  }
  .latest li.day + li {
    border-top: 0;
  }
  .more-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: var(--tap);
    margin-top: 8px;
    border: 2px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    font: 700 0.9375rem / 1 var(--font-hud);
    cursor: pointer;
  }
  .more-btn:hover,
  .more-btn:focus-visible {
    background: var(--shd);
    color: var(--on-shd);
  }
  .latest time {
    color: var(--ink-soft);
    text-transform: none;
  }
  .latest a {
    display: block;
    font-weight: 700;
    line-height: 1.45;
  }
  .latest .sec {
    font-size: 0.8125rem;
    color: var(--ink-soft);
  }
  .fixture-note {
    margin: var(--space-4) 0 0;
    padding: 8px 12px;
    border: 1.5px dashed var(--shd-ink);
    color: var(--shd-ink);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .front {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-5);
  }
  .secondary {
    display: grid;
    gap: var(--space-4);
    border-top: 2px solid var(--rule);
    padding-top: var(--space-4);
  }
  .cols {
    display: grid;
    gap: var(--space-4);
  }
  .glitch-list,
  .tldr {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .glitch-list li,
  .tldr li {
    padding: 8px 0;
    border-bottom: 1px solid var(--rule-soft);
  }
  .glitch-list li:last-child,
  .tldr li:last-child {
    border-bottom: 0;
  }
  .glitch-list a {
    display: block;
    font-weight: 700;
    padding: 4px 0;
  }
  .glitch-list small {
    display: block;
    color: var(--ink-soft);
  }
  .gstate {
    display: inline-block;
    padding: 0 6px;
    font: 600 0.75rem / 1.6 var(--font-hud);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--hazard);
    color: #111;
  }
  .gstate.patched,
  .gstate.hotfixed {
    background: var(--ok-green);
    color: #fff;
  }
  .ban {
    display: block;
    color: var(--dz-red);
  }
  .section-head h2 a {
    text-decoration: none;
  }
  .section-head h2 a:hover {
    text-decoration: underline;
  }
  .tldr a {
    text-decoration: none;
  }
  .tldr .more::before {
    content: none;
  }
  .tldr li::before {
    content: '▸ ';
    color: var(--shd-ink);
  }
  .satire-text {
    margin: 0;
    font-style: italic;
  }
  .empty {
    font-style: italic;
    color: var(--ink-soft);
  }
  .sat-tag {
    color: var(--dz-red) !important;
    font: 600 var(--step--1) var(--font-hud) !important;
    letter-spacing: 0.1em;
  }

  .watch-grid {
    display: grid;
    gap: var(--space-5);
  }
  .wside {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  .all {
    display: inline-block;
    padding: 8px 0;
    color: var(--shd-ink);
    font-weight: 700;
  }
  @media (min-width: 1024px) {
    .watch-grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    }
  }
  @media (min-width: 768px) {
    .secondary,
    .cols {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--space-5);
    }
  }
  @media (min-width: 1024px) {
    .front {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      gap: 0;
    }
    .lead-col {
      padding-right: var(--space-5);
      border-right: 1px solid var(--rule);
    }
    .side {
      padding-left: var(--space-5);
    }
    .secondary,
    .cols {
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
    }
    /* column rules between stories */
    .secondary > :global(*),
    .cols > :global(*) {
      padding: 0 var(--space-4);
      border-left: 1px solid var(--rule-soft);
    }
    .secondary > :global(*:first-child),
    .cols > :global(*:first-child) {
      padding-left: 0;
      border-left: 0;
    }
    .back .cols > :global(*) {
      border-left: 1.5px solid var(--rule);
      margin: 0 var(--space-2);
    }
  }
</style>

<script>
  // 最新更新 「顯示更多」: open STEP more rows per tap; when all are open the button collapses back.
  document.querySelectorAll<HTMLButtonElement>('[data-latest-more]').forEach((btn) => {
    const list = btn.parentElement?.querySelector<HTMLElement>('[data-latest]');
    if (!list) return;
    const first = Number(list.dataset.first) || 6;
    const step = Number(list.dataset.step) || 10;
    const rows = [...list.querySelectorAll<HTMLElement>('li[data-n]')];
    const total = Math.max(...rows.map((r) => Number(r.dataset.n))) + 1;
    let open = first;
    const render = () => {
      rows.forEach((r) => (r.hidden = Number(r.dataset.n) >= open));
      const left = total - open;
      const all = left <= 0;
      btn.textContent = all ? (btn.dataset.less ?? '') : (btn.dataset.more ?? '').replace('{n}', String(Math.min(step, left)));
      btn.setAttribute('aria-expanded', String(all));
    };
    btn.addEventListener('click', () => {
      if (open >= total) {
        open = first;
        render();
        list.closest('section')?.scrollIntoView({ block: 'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        return;
      }
      const firstNew = rows.find((r) => Number(r.dataset.n) === open && !r.classList.contains('day'));
      open = Math.min(total, open + step);
      render();
      firstNew?.querySelector('a')?.focus({ preventScroll: true });
    });
  });
</script>
