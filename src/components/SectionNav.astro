---
import { t, type Locale, type UiKey } from '../i18n/index.ts';
import { routes } from '../lib/routes.ts';
import type { Category } from '../schema/item.ts';

interface Props {
  locale: Locale;
  sections: Category[];
  current?: Category | 'archive' | 'patches' | 'search' | 'guides';
}
const { locale, sections, current } = Astro.props;
const tools = [
  { key: 'archive', href: routes.archive(locale), label: t(locale, 'nav.archive') },
  { key: 'patches', href: routes.patches(locale), label: t(locale, 'nav.patches') },
  { key: 'search', href: routes.search(locale), label: `⌕ ${t(locale, 'nav.search')}` },
] as const;
---
<nav class="snav" aria-label={t(locale, 'nav.sections')}>
  <ul>
    {
      sections.map((s, i) => (
        <>
        <li>
          <a
            href={s === 'back-page' ? `${routes.home(locale)}#back-page` : routes.section(locale, s)}
            class:list={[s === 'glitch-watch' && 'hz', s === 'dark-zone' && 'dz']}
            aria-current={current === s ? 'page' : undefined}
          >
            {t(locale, `section.${s}` as UiKey)}
          </a>
        </li>
        {i === 0 && (
          // 特工情報站: missions, codes and 灰帽特工's news — 2nd button and highlighted, so readers find it (owner, 2026-11-28).
          <li>
            <a href={routes.guides(locale)} class="intel-nav" aria-current={current === 'guides' ? 'page' : undefined}>
              <span aria-hidden="true">🎯</span> {t(locale, 'nav.guides')}
            </a>
          </li>
        )}
        </>
      ))
    }
    <li class="sep" aria-hidden="true"></li>
    {
      tools.map((x) => (
        <li>
          <a href={x.href} class="tool" aria-current={current === x.key ? 'page' : undefined}>
            {x.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .snav {
    position: sticky;
    top: calc(var(--bar-h) + env(safe-area-inset-top));
    z-index: 15;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }
  ul {
    display: flex;
    gap: 2px;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  ul::-webkit-scrollbar {
    display: none;
  }
  li {
    flex: none;
    scroll-snap-align: start;
  }
  .sep {
    width: 1px;
    margin: 10px 6px;
    background: var(--rule-soft);
  }
  a {
    display: flex;
    align-items: center;
    min-height: var(--nav-h);
    padding: 0 12px;
    font: 600 0.875rem / 1 var(--font-hud);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 3px solid transparent;
  }
  a:hover,
  a:focus-visible,
  a[aria-current='page'] {
    border-bottom-color: var(--shd);
  }
  a[aria-current='page'] {
    color: var(--shd-ink);
  }
  .tool {
    color: var(--shd-ink);
  }
  .hz {
    box-shadow: inset 4px 0 0 var(--hazard);
  }
  /* 特工情報站: an orange chip that stands out from the other sections. */
  .intel-nav {
    gap: 5px;
    margin: 2px;
    min-height: max(44px, calc(var(--nav-h) - 4px)); /* phone tap target */
    padding: 0 12px;
    border: 1px solid var(--shd);
    border-radius: 4px;
    background: var(--shd);
    color: var(--on-shd); /* the site's text colour for SHD orange: dark on orange (6.5:1), white on the Hunter red */
  }
  .intel-nav:hover,
  .intel-nav:focus-visible,
  .intel-nav[aria-current='page'] {
    border-bottom-color: var(--shd);
    box-shadow: 0 0 0 2px var(--paper), 0 0 0 4px var(--shd);
    color: var(--on-shd);
  }
  .dz {
    box-shadow: inset 4px 0 0 var(--dz-red);
  }
  :lang(zh) a {
    font-family: var(--font-cjk);
    font-size: 0.9375rem;
    letter-spacing: 0.08em;
  }
  @media (min-width: 768px) {
    .snav {
      top: 0;
    }
  }
  @media (min-width: 1024px) {
    ul {
      flex-wrap: wrap;
      overflow: visible;
    }
  }
</style>
