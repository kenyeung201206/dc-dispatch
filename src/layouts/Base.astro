---
// Self-hosted OFL fonts. Latin fonts load only the latin subset;
// Noto Serif TC is split into unicode-range slices, so a page only downloads the glyphs it uses.
import '@fontsource/playfair-display/latin-700.css';
import '@fontsource/playfair-display/latin-900.css';
import '@fontsource/libre-caslon-text/latin-400.css';
import '@fontsource/libre-caslon-text/latin-400-italic.css';
import '@fontsource/libre-caslon-text/latin-700.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import '@fontsource/noto-serif-tc/500.css';
import '@fontsource/noto-serif-tc/900.css';
import '../styles/global.css';
import { HTML_LANG, t, type Locale } from '../i18n/index.ts';

interface Props {
  locale: Locale;
  title?: string;
}
const { locale, title } = Astro.props;
const pageTitle = title ? `${title} · ${t(locale, 'site.name')}` : t(locale, 'site.name');
---
<!doctype html>
<html lang={HTML_LANG[locale]} data-theme="day">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f3eee3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121416" media="(prefers-color-scheme: dark)" />
    <!-- Home-screen app (iOS + Android). The manifest needs the sign-in cookie on the way back, hence use-credentials. -->
    <link rel="manifest" href="/manifest.webmanifest" crossorigin="use-credentials" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="DC Dispatch" />
    <!-- "default": the page starts below the status bar like in Safari (no glass blur over content under the Dynamic Island). -->
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>{pageTitle}</title>
    <script is:inline>
      // Pick the theme before first paint: saved choice, else the OS setting, else Day.
      (function () {
        var t = null;
        try { t = localStorage.getItem('dcd.theme'); } catch (e) {}
        if (t !== 'day' && t !== 'night') {
          t = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'night' : 'day';
        }
        document.documentElement.dataset.theme = t;
      })();
      // Opening or reloading a page starts at the top (browsers otherwise restore the last position,
      // e.g. the bottom of the long front page). Going Back still returns to where you were.
      (function () {
        try {
          var nav = performance.getEntriesByType('navigation')[0];
          if (location.hash || (nav && nav.type === 'back_forward')) return;
          var touched = false;
          var mark = function () { touched = true; };
          ['wheel', 'touchstart', 'keydown', 'mousedown'].forEach(function (ev) { addEventListener(ev, mark, { once: true, passive: true }); });
          var top = function () { if (!touched && scrollY > 0) scrollTo(0, 0); };
          addEventListener('load', function () { top(); setTimeout(top, 0); requestAnimationFrame(top); });
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t(locale, 'nav.skip')}</a>
    <slot name="masthead" />
    <main id="main" class="wrap" tabindex="-1">
      <slot />
    </main>
    <button type="button" class="to-top" data-to-top hidden aria-label={t(locale, 'nav.toTop')}><span aria-hidden="true">▲</span><span class="tt">{t(locale, 'nav.toTopShort')}</span></button>
    <div class="toast" role="status" aria-live="polite" data-toast data-on={t(locale, 'egg.hunterOn')} data-off={t(locale, 'egg.hunterOff')}></div>
    <footer class="site-footer">
      <div class="wrap">
        <p>{t(locale, 'footer.disclaimer')}</p>
        <p>{t(locale, 'footer.aiNote')}</p>
        <p><a href={`/${locale}/status/`}>{t(locale, 'footer.status')}</a> · <a href="/__logout">{t(locale, 'footer.signOut')}</a></p>
      </div>
    </footer>
    <script>
      document.querySelectorAll<HTMLElement>('[data-lang-switch]').forEach((el) =>
        el.addEventListener('click', () => {
          try {
            localStorage.setItem('dcd.lang', el.dataset.langSwitch ?? '');
          } catch {}
        }),
      );
      document.querySelectorAll('[data-theme-toggle]').forEach((el) =>
        el.addEventListener('click', () => {
          const root = document.documentElement;
          const next = root.dataset.theme === 'night' ? 'day' : 'night';
          root.dataset.theme = next;
          try {
            localStorage.setItem('dcd.theme', next);
          } catch {}
        }),
      );

      // Floating back-to-top: appears after scrolling about a screen and a half.
      const top = document.querySelector<HTMLButtonElement>('[data-to-top]');
      if (top) {
        const sync = () => (top.hidden = window.scrollY < window.innerHeight * 1.5);
        window.addEventListener('scroll', sync, { passive: true });
        sync();
        top.addEventListener('click', () => {
          const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: calm ? 'auto' : 'smooth' });
          document.querySelector<HTMLElement>('#main')?.focus({ preventScroll: true });
        });
      }
      // Return button: go back like the browser would; from a fresh/outside visit, go to the section or home.
      document.querySelectorAll<HTMLAnchorElement>('[data-back]').forEach((a) =>
        a.addEventListener('click', (e) => {
          let fromHere = false;
          try {
            fromHere = Boolean(document.referrer) && new URL(document.referrer).origin === location.origin;
          } catch {}
          if (fromHere && history.length > 1) {
            e.preventDefault();
            history.back();
          }
        }),
      );

      // 新 badges: stories published since this reader's last visit (per browser; a visit = a break of 30+ min).
      // First visit: the last 12 hours. Never older than 3 days.
      (() => {
        const H = 3_600_000;
        const now = Date.now();
        let prev = now - 12 * H;
        try {
          const last = Number(localStorage.getItem('dcd.lastSeen')) || 0;
          const saved = Number(localStorage.getItem('dcd.prevVisit')) || 0;
          prev = last && now - last < 0.5 * H ? saved || prev : last || prev;
          localStorage.setItem('dcd.prevVisit', String(prev));
          localStorage.setItem('dcd.lastSeen', String(now));
        } catch {}
        const since = Math.max(prev, now - 72 * H);
        document.querySelectorAll<HTMLElement>('[data-new-badge]').forEach((b) => {
          const t = Date.parse(b.dataset.firstSeen ?? '');
          if (t > since) b.hidden = false;
        });
      })();

      // ---- Easter eggs (no sound, ever) ----
      console.log(
        '%c SHD NETWORK %c Curious, Agent? The pipeline lives in /pipeline, the jokes in src/lib/humour.ts. Try the Konami code. ',
        'background:#ff6d10;color:#111;font-weight:bold;padding:2px 6px',
        'color:inherit',
      );
      const toast = document.querySelector<HTMLElement>('[data-toast]');
      let toastTimer = 0;
      const say = (msg: string) => {
        if (!toast) return;
        toast.textContent = msg;
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toast.classList.remove('show'), 3200);
      };
      const toggleHunter = () => {
        const root = document.documentElement;
        const on = root.dataset.mask !== 'hunter';
        if (on) root.dataset.mask = 'hunter';
        else delete root.dataset.mask;
        say((on ? toast?.dataset.on : toast?.dataset.off) ?? '');
      };
      const KONAMI = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
      let k = 0;
      document.addEventListener('keydown', (e) => {
        k = e.key.toLowerCase() === KONAMI[k]!.toLowerCase() ? k + 1 : e.key === 'ArrowUp' ? (k === 1 ? 2 : 1) : 0;
        if (k === KONAMI.length) {
          k = 0;
          toggleHunter();
        }
      });
      // Tap the masthead hex: silent scan. Five quick taps: Hunter mode (phones have no arrow keys).
      let taps: number[] = [];
      document.querySelectorAll<HTMLElement>('[data-hex]').forEach((hex) =>
        hex.addEventListener('click', () => {
          const head = hex.closest<HTMLElement>('.masthead');
          head?.classList.remove('scanning');
          void head?.offsetWidth;
          head?.classList.add('scanning');
          const now = Date.now();
          taps = [...taps.filter((t) => now - t < 3000), now];
          if (taps.length >= 5) {
            taps = [];
            toggleHunter();
          }
        }),
      );
    </script>
    <style>
      .toast {
        position: fixed;
        left: 50%;
        bottom: calc(16px + env(safe-area-inset-bottom));
        z-index: 50;
        max-width: min(92vw, 480px);
        padding: 10px 16px;
        background: var(--panel);
        color: var(--panel-ink);
        border-left: 4px solid var(--shd);
        font: 600 0.875rem / 1.4 var(--font-hud);
        transform: translate(-50%, 200%);
        transition: transform 0.25s ease-out;
      }
      .toast:empty {
        display: none;
      }
      .toast.show {
        transform: translate(-50%, 0);
      }
      .to-top {
        position: fixed;
        right: max(16px, env(safe-area-inset-right));
        bottom: calc(16px + env(safe-area-inset-bottom));
        z-index: 40;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        border: 2px solid var(--ink);
        border-radius: 50%;
        background: var(--shd);
        color: var(--on-shd);
        font: 700 0.6875rem / 1 var(--font-hud);
        box-shadow: 0 3px 10px rgb(0 0 0 / 0.25);
        cursor: pointer;
      }
      .to-top[hidden] {
        display: none;
      }
      .to-top span:first-child {
        font-size: 1rem;
      }
      .to-top:focus-visible {
        outline: 3px solid var(--ink);
        outline-offset: 3px;
      }
      @media print {
        .to-top {
          display: none;
        }
      }
      .site-footer {
        margin-top: var(--space-6);
        /* Extra room so the floating Return / Top buttons never cover the last links. */
        padding: var(--space-5) 0 calc(88px + env(safe-area-inset-bottom));
        border-top: 4px double var(--rule);
        font: 400 var(--step--1) / 1.6 var(--font-hud);
        color: var(--ink-soft);
      }
      .site-footer a {
        display: inline-block;
        padding: 6px 0;
      }
      .site-footer p {
        margin: 0 0 8px;
        max-width: 80ch;
      }
    </style>
  </body>
</html>
