---
import Paper from '../../layouts/Paper.astro';
import { HTML_LANG, LOCALES, t, type Locale } from '../../i18n/index.ts';
import { editions, localized, byImportance } from '../../lib/editions.ts';
import { routes } from '../../lib/routes.ts';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const latest = editions[0]?.date;
const byDate = new Map(editions.map((e) => [e.date, e]));
const hrefFor = (date: string) => (date === latest ? routes.home(locale) : routes.edition(locale, date));

// Months that have at least one edition, newest first.
const months = [...new Set(editions.map((e) => e.date.slice(0, 7)))];
const weekdays = t(locale, 'weekday.short').split(',');
const monthLabel = (ym: string) =>
  new Intl.DateTimeFormat(HTML_LANG[locale], { year: 'numeric', month: 'long', timeZone: 'UTC' }).format(new Date(`${ym}-01T00:00:00Z`));

function grid(ym: string): (string | null)[] {
  const [y, m] = ym.split('-').map(Number) as [number, number];
  const first = new Date(Date.UTC(y, m - 1, 1));
  const days = new Date(Date.UTC(y, m, 0)).getUTCDate();
  const lead = (first.getUTCDay() + 6) % 7; // Monday first
  const cells: (string | null)[] = Array.from({ length: lead }, () => null);
  for (let d = 1; d <= days; d++) cells.push(`${ym}-${String(d).padStart(2, '0')}`);
  return cells;
}
---
<Paper locale={locale} title={t(locale, 'archive.title')} current="archive">
  <header class="section-head page-head">
    <h1>{t(locale, 'archive.title')}</h1>
    <p>{t(locale, 'archive.intro')}</p>
  </header>

  {
    months.map((ym) => (
      <section class="month" aria-label={monthLabel(ym)}>
        <h2 class="hud-label">{monthLabel(ym)}</h2>
        <div class="cal" role="grid">
          {weekdays.map((w) => <span class="wd" role="columnheader">{w}</span>)}
          {grid(ym).map((d) =>
            !d ? (
              <span class="day empty" />
            ) : byDate.has(d) ? (
              <a class="day has" href={hrefFor(d)} aria-label={d}>
                {Number(d.slice(8))}
              </a>
            ) : (
              <span class="day">{Number(d.slice(8))}</span>
            ),
          )}
        </div>
      </section>
    ))
  }

  <ol class="list">
    {
      editions.map((e) => {
        const top = [...e.items].sort(byImportance)[0];
        return (
          <li>
            <a href={hrefFor(e.date)}>
              <span class="hud-label">
                {t(locale, 'archive.edition')} {String(e.editionNumber).padStart(3, '0')} · <time datetime={e.date}>{e.date}</time>
                {e.date === latest && <em> · {t(locale, 'archive.latest')}</em>}
              </span>
              {top && <strong>{localized(top, 'headline', locale).text}</strong>}
            </a>
          </li>
        );
      })
    }
  </ol>
</Paper>

<style>
  .page-head h1 {
    margin: 0;
    font: 900 var(--step-3) / 1.1 var(--font-display);
  }
  :lang(zh-Hant-TW) .page-head h1 {
    font-family: var(--font-cjk);
  }
  .month {
    max-width: 420px;
    margin-bottom: var(--space-5);
  }
  .cal {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }
  .wd {
    text-align: center;
    font: 600 0.75rem var(--font-hud);
    color: var(--ink-soft);
  }
  .day {
    display: grid;
    place-items: center;
    min-height: var(--tap);
    font: 400 0.9375rem var(--font-hud);
    color: var(--ink-soft);
    border: 1px solid var(--rule-soft);
  }
  .day.empty {
    border: 0;
  }
  .day.has {
    background: var(--shd);
    color: var(--on-shd);
    font-weight: 600;
    text-decoration: none;
    border-color: var(--shd);
  }
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--rule);
  }
  .list li {
    border-bottom: 1px solid var(--rule-soft);
  }
  .list a {
    display: grid;
    gap: 4px;
    padding: 12px 0;
    text-decoration: none;
  }
  .list strong {
    font: 700 var(--step-1) / 1.3 var(--font-display);
  }
  :lang(zh-Hant-TW) .list strong {
    font-family: var(--font-cjk);
  }
</style>
