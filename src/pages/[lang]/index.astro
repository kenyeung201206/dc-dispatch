---
import Paper from '../../layouts/Paper.astro';
import EditionFront from '../../components/EditionFront.astro';
import { LOCALES, type Locale } from '../../i18n/index.ts';
import { latestEdition } from '../../lib/editions.ts';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const edition = latestEdition();
---
<Paper locale={locale} edition={edition} current="front-page">
  <EditionFront locale={locale} edition={edition} />
</Paper>
