---
import Paper from '../../../layouts/Paper.astro';
import Photo from '../../../components/Photo.astro';
import VideoFacade from '../../../components/VideoFacade.astro';
import Stamp from '../../../components/Stamp.astro';
import StoryCard from '../../../components/StoryCard.astro';
import FavButton from '../../../components/FavButton.astro';
import { formatDate, LOCALES, t, tf, type Locale, type UiKey } from '../../../i18n/index.ts';
import { allItems, findItem, localized, readableIn, relatedItems } from '../../../lib/editions.ts';
import { sourceZh } from '../../../lib/zh.ts';
import { briefFor } from '../../../lib/briefs.ts';
import { relatedChineseVideos } from '../../../lib/related-videos.ts';
import { imageFor } from '../../../lib/images.ts';
import { routes } from '../../../lib/routes.ts';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) => allItems.map((item) => ({ params: { lang, id: item.id } })));
}
const locale = Astro.params.lang as Locale;
const item = findItem(Astro.params.id!)!;
const headline = localized(item, 'headline', locale);
const summary = localized(item, 'summary', locale);
const whyRaw = item.whyItMatters_en ? localized(item, 'whyItMatters', locale) : null;
const zhPage = locale !== 'en';
// Chinese pages never show English: untranslated extras are dropped, untranslated stories get a notice instead.
const why = whyRaw && !(zhPage && whyRaw.pending) ? whyRaw : null;
const untranslated = zhPage && !readableIn(item, locale);
const kind = (zhPage && item.summaryKind_zhHant) || item.summaryKind;
const src = (name: string) => (zhPage ? sourceZh(name) : name);
// Chinese readers of an English story: videos by Chinese-speaking creators on the same topic.
const zhVideos = zhPage && !item.lang_orig.startsWith('zh') ? relatedChineseVideos(item) : [];
const photo = imageFor(item, new Set());
// 重點整理: our own fuller Chinese write-up of the source (Chinese pages only).
const brief = zhPage ? briefFor(item.id) : undefined;
const related = relatedItems(item, locale);
const sources = [{ name: item.sourceName, url: item.sourceUrl }, ...item.alsoReportedBy];
const sectionLabel = t(locale, `section.${item.category}` as UiKey);
const riskNote = item.glitch
  ? locale === 'en'
    ? item.glitch.riskNote_en
    : item.glitch.riskNote_zhHant === 'pending'
      ? null
      : item.glitch.riskNote_zhHant
  : null;
const reportHref = `mailto:?subject=${encodeURIComponent(`[DC Dispatch] Translation issue: ${item.id}`)}&body=${encodeURIComponent(`Story: ${item.headline_en}\nPage: ${routes.story(locale, item.id)}\n\nWhat's wrong:\n`)}`;
---
<Paper
  locale={locale}
  title={untranslated ? t(locale, 'story.noZh.title') : headline.text}
  current={item.category}
  description={untranslated || summary.pending ? undefined : summary.text.slice(0, 200)}
  image={photo?.image.url ?? (item.videoId ? `https://i.ytimg.com/vi/${item.videoId}/hqdefault.jpg` : undefined)}
>
  {
    untranslated && (
      <article class="story-page nozh">
        <nav class="crumbs hud-label" aria-label="Breadcrumb">
          <a href={routes.home(locale)}>{t(locale, 'nav.home')}</a> /
          <a href={routes.section(locale, item.category)}>{sectionLabel}</a>
        </nav>
        <h1 class="headline">{t(locale, 'story.noZh.title')}</h1>
        <p class="summary">{tf(locale, 'story.noZh.text', { source: src(item.sourceName) })}</p>
        <p class="links">
          <a class="cta" href={item.sourceUrl} rel="noopener noreferrer" target="_blank">{t(locale, 'story.readOriginal')}</a>
          <a href={routes.story('en', item.id)} hreflang="en">{t(locale, 'story.noZh.english')}</a>
        </p>
      </article>
    )
  }
  {!untranslated && (
  <article class="story-page" data-pagefind-body>
    <nav class="crumbs hud-label" aria-label="Breadcrumb">
      <a href={routes.home(locale)}>{t(locale, 'nav.home')}</a> /
      <a href={routes.section(locale, item.category)}>{sectionLabel}</a>
    </nav>

    <div class="meta" data-pagefind-ignore>
      <Stamp locale={locale} confidence={item.confidence} />
      {item.status === 'updated' && <span class="hud-label upd">{t(locale, 'status.updated')}</span>}
      <time class="hud-label" datetime={item.publishedAt}>{formatDate(item.publishedAt, locale)}</time>
    </div>

    <h1 class="headline" lang={headline.pending ? headline.lang : undefined} data-pagefind-meta="title">{headline.text}</h1>
    {headline.pending && <p class="pending">{t(locale, 'translation.pending')}</p>}
    <p class="favrow"><FavButton locale={locale} id={item.id} size="large" /></p>
    {
      !zhPage && (locale !== item.lang_orig.slice(0, 2) || headline.text !== item.title_orig) && (
        <p class="orig">
          {t(locale, 'story.original')}: <span lang={item.lang_orig}>{item.title_orig}</span>
        </p>
      )
    }

    {
      item.videoId && (
        <VideoFacade
          locale={locale}
          size="large"
          video={{
            id: item.videoId,
            title: item.title_orig,
            ...(zhPage && !headline.pending ? { titleZh: headline.text } : {}),
            channelName: item.sourceName,
            channelUrl: item.sourceUrl,
            publishedAt: item.publishedAt,
            official: false,
            row: 'intel',
            rumour: item.confidence === 'rumour',
            checkedAt: item.fetchedAt,
            via: 'youtube-search',
          }}
        />
      )
    }
    {photo && <Photo locale={locale} image={photo.image} filePhoto={photo.filePhoto} variant="lead" eager />}

    <p class:list={['summary', kind === 'extract' && 'quote']} lang={summary.pending ? summary.lang : undefined}>
      {kind === 'extract' ? `“${summary.text}”` : summary.text}
      {kind === 'extract' && <span class="attrib"> — {src(item.sourceName)}</span>}
    </p>
    {summary.pending && <p class="pending">{t(locale, 'translation.pending')}</p>}
    {item.summaryKind === 'ai' && <p class="pending">{t(locale, 'story.aiSummary')}</p>}

    {
      why && (
        <p class="why">
          <strong>{t(locale, 'story.whyItMatters')}:</strong> <span lang={why.pending ? why.lang : undefined}>{why.text}</span>
        </p>
      )
    }

    {
      brief && (
        <section class="brief" aria-labelledby="brief-h">
          <h2 id="brief-h">{t(locale, 'story.brief')}</h2>
          <ul class="points">
            {brief.points.map((p) => <li>{p}</li>)}
          </ul>
          {(brief.tables ?? []).map((tb) => (
            <div class="tablewrap">
              <table>
                <caption>{tb.title}</caption>
                <thead>
                  <tr>{tb.columns.map((c) => <th scope="col">{c}</th>)}</tr>
                </thead>
                <tbody>
                  {tb.rows.map((r) => (
                    <tr>{r.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          ))}
          {(brief.body ?? []).map((p) => <p>{p}</p>)}
          <p class="briefnote">{t(locale, 'story.briefNote')}</p>
        </section>
      )
    }

    {
      item.glitch && (
        <dl class="glitch">
          <dt>{t(locale, 'filter.status')}</dt>
          <dd><span class:list={['gstate', item.glitch.state]}>{t(locale, `glitch.${item.glitch.state}` as UiKey)}</span></dd>
          <dt>{t(locale, 'glitch.firstSeen')}</dt>
          <dd><time datetime={item.glitch.firstSeen}>{item.glitch.firstSeen}</time></dd>
          {item.glitch.banRisk && <dd class="ban">{t(locale, 'glitch.banRisk')}</dd>}
          {riskNote && <dd class="note">{riskNote}</dd>}
        </dl>
      )
    }

    {
      zhVideos.length > 0 && (
        <section class="zhvids" aria-labelledby="zhv-h" data-pagefind-ignore>
          <h2 id="zhv-h" class="hud-label">{t(locale, 'story.zhVideos')}</h2>
          <p class="zhv-note">{t(locale, item.videoId ? 'story.zhVideosNoteVideo' : 'story.zhVideosNote')}</p>
          <div class="zhv-grid">
            {zhVideos.map((v) => <VideoFacade locale={locale} video={v} />)}
          </div>
        </section>
      )
    }

    <section class="sources" aria-labelledby="src-h">
      <h2 id="src-h" class="hud-label">
        {sources.length > 1 ? tf(locale, 'story.reportedBy', { n: sources.length }) : t(locale, 'story.source')}
      </h2>
      <ul>
        {sources.map((s) => <li><a href={s.url} rel="noopener noreferrer" target="_blank">{src(s.name)} ↗</a></li>)}
      </ul>
      <a class="cta" href={item.sourceUrl} rel="noopener noreferrer" target="_blank">{t(locale, 'story.readOriginal')}</a>
    </section>

    <p class="ai hud-label" data-pagefind-ignore>
      {t(locale, 'story.aiNote')} <a href={reportHref}>{t(locale, 'story.reportTranslation')}</a>
    </p>

    <!-- Search filters (Pagefind) -->
    <span hidden data-pagefind-filter={t(locale, 'filter.category')}>{sectionLabel}</span>
    <span hidden data-pagefind-filter={t(locale, 'filter.confidence')}>{t(locale, `confidence.${item.confidence}` as UiKey)}</span>
    <span hidden data-pagefind-filter={t(locale, 'filter.source')}>{src(item.sourceName)}</span>
  </article>
  )}

  {
    related.length > 0 && (
      <section class="related" aria-labelledby="rel-h">
        <header class="section-head">
          <h2 id="rel-h">{t(locale, 'story.related')}</h2>
        </header>
        <div class="cols">
          {related.map((r) => <StoryCard locale={locale} item={r} variant="brief" />)}
        </div>
      </section>
    )
  }
</Paper>

<style>
  .story-page {
    max-width: 760px;
    margin: var(--space-5) auto 0;
  }
  .crumbs {
    margin: 0 0 var(--space-3);
    color: var(--ink-soft);
  }
  .crumbs a {
    display: inline-block;
    padding: 8px 0;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    align-items: center;
    color: var(--ink-soft);
  }
  .upd {
    color: var(--shd-ink);
  }
  .headline {
    margin: 10px 0 8px;
    font: 900 var(--step-3) / 1.1 var(--font-display);
    text-wrap: balance;
  }
  .favrow {
    margin: 0 0 var(--space-3);
  }
  .headline:lang(zh),
  :lang(zh) .headline {
    font-family: var(--font-cjk);
    line-height: 1.3;
  }
  .orig,
  .pending {
    margin: 0 0 var(--space-3);
    font: 400 var(--step--1) / 1.5 var(--font-hud);
    color: var(--ink-soft);
  }
  .pending {
    color: var(--shd-ink);
  }
  .summary {
    font-size: 1.1875rem;
    line-height: 1.65;
  }
  .quote {
    font-style: italic;
  }
  .zhvids {
    margin: var(--space-5) 0;
    padding-top: var(--space-3);
    border-top: 3px solid var(--shd);
  }
  .zhv-note {
    margin: 4px 0 var(--space-3);
    color: var(--ink-soft);
  }
  .zhv-grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
  }
  .attrib {
    font-style: normal;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .why {
    padding-left: 12px;
    border-left: 3px solid var(--shd);
  }
  /* 重點整理: key points, full data tables, then the details. */
  .brief {
    margin-block: var(--space-5);
    padding-top: var(--space-3);
    border-top: 3px solid var(--rule);
  }
  .brief h2 {
    margin: 0 0 var(--space-3);
    font: 800 var(--step-1) / 1.3 var(--font-display);
  }
  .brief .points {
    margin: 0 0 var(--space-4);
    padding-left: 1.25em;
    display: grid;
    gap: var(--space-2);
    font-size: var(--step-0);
    line-height: 1.7;
  }
  .brief .points li::marker {
    color: var(--shd);
  }
  .brief p {
    line-height: 1.8;
  }
  .tablewrap {
    margin-block: var(--space-4);
    overflow-x: auto; /* wide tables scroll inside their box on phones, never the page */
    -webkit-overflow-scrolling: touch;
  }
  .brief table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
    line-height: 1.6;
  }
  .brief caption {
    text-align: left;
    padding-bottom: var(--space-2);
    font: 700 var(--step-0) / 1.4 var(--font-hud);
  }
  .brief th,
  .brief td {
    padding: 8px 10px;
    border-bottom: 1px solid var(--rule-soft);
    text-align: left;
    vertical-align: top;
  }
  .brief thead th {
    background: var(--panel);
    color: var(--panel-ink);
    font-family: var(--font-hud);
    white-space: nowrap;
  }
  .brief tbody th {
    font-weight: 700;
    min-width: 6.5em;
  }
  .brief tbody tr:nth-child(even) {
    background: var(--paper-2);
  }
  .briefnote {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  .glitch {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 12px;
    padding: 12px 14px;
    border: 1.5px solid var(--rule);
    border-top: 6px solid var(--hazard);
  }
  .glitch dt {
    font: 600 var(--step--1) var(--font-hud);
    text-transform: uppercase;
  }
  .glitch dd {
    margin: 0;
  }
  .glitch .ban,
  .glitch .note {
    grid-column: 1 / -1;
  }
  .ban {
    color: var(--dz-red);
    font-weight: 700;
  }
  .gstate {
    padding: 0 6px;
    font: 600 0.75rem / 1.6 var(--font-hud);
    text-transform: uppercase;
    background: var(--hazard);
    color: #111;
  }
  .gstate.patched,
  .gstate.hotfixed {
    background: var(--ok-green);
    color: #fff;
  }
  .sources {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 2px solid var(--rule);
  }
  .sources h2 {
    margin: 0 0 6px;
  }
  .sources ul {
    margin: 0 0 var(--space-3);
    padding-left: 1.2em;
  }
  .sources li a {
    display: inline-block;
    padding: 6px 0;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 18px;
    background: var(--shd);
    color: var(--on-shd);
    font: 600 0.9375rem var(--font-hud);
    text-decoration: none;
  }
  .cta:hover {
    color: var(--on-shd);
    filter: brightness(1.08);
  }
  .ai {
    margin-top: var(--space-4);
    color: var(--ink-soft);
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
  }
  .ai a {
    display: inline-block;
    padding: 6px 0;
  }
  .related {
    max-width: var(--max);
  }
  .cols {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 768px) {
    .cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .cols {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
