{
  "name": "dc-dispatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/simplify.ts && pagefind --site dist && node scripts/sitemap.ts",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "i18n:check": "node scripts/check-i18n.ts",
    "ci": "pnpm run i18n:check && pnpm run check && pnpm run test && pnpm run build",
    "test:e2e": "playwright test",
    "screens": "node -e \"process.env.SCREENS=String(1);require('child_process').execSync('playwright test screen --project=desktop-chromium --project=iphone',{stdio:'inherit'})\"",
    "refresh": "node --env-file-if-exists=.env pipeline/refresh.ts",
    "refresh:dry": "node pipeline/refresh.ts --dry-run",
    "deploy": "wrangler pages deploy dist --project-name=${CF_PAGES_PROJECT:-dc-dispatch} --branch=main",
    "preview:cf": "wrangler pages dev dist --port 8788",
    "icons": "node scripts/make-icons.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/libre-caslon-text": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.1",
    "@fontsource/noto-serif-tc": "5.3.1",
    "@fontsource/playfair-display": "5.3.0",
    "astro": "7.4.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "opencc-js": "1.4.2",
    "pagefind": "1.6.0",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.151.3"
  }
}
