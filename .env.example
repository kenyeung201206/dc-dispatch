# Copy to .env and fill in. Never commit .env.
# In GitHub, add the same names under Settings → Secrets and variables → Actions.

# YouTube Data API v3 (Watch Now section)
YOUTUBE_API_KEY=

# Twitch Helix app credentials (Live Now + clips)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: enables bilingual AI summaries. Without it, summaries are extracts
# and Chinese shows "翻譯待補 / translation pending".
ANTHROPIC_API_KEY=
# Optional: model for summaries (default claude-opus-5-5; claude-haiku-5-5 is ~40x cheaper) and a daily spend cap in USD (default 0.50)
AI_MODEL=
AI_DAILY_BUDGET_USD=

# Cloudflare Access allowlist (the two readers)
ALLOWED_EMAIL_1=
ALLOWED_EMAIL_2=

# Cloudflare deploy (Phase 7)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Humour level: light | medium | full
HUMOUR_LEVEL=medium
